#!/bin/sh
# every module loaded the checker, none failed, and none went missing
# (ONLY= runs a few on purpose)
[ "$(grep -c 'round trip holds' "$1")" = "$(grep -c '^=== ' "$1")" ] \
    && [ "$(grep -c '^=== ' "$1")" -ge "$([ -n "${ONLY:-}" ] && echo 1 || echo 30)" ] \
    && ! grep -q "FAIL" "$1"
